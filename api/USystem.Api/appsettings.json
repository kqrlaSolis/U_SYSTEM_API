{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ServerVersion": "8.0.36-mysql",
    "AutoDetectServerVersion": false
  },
  "Jwt": {
    "Issuer": "USystem",
    "Audience": "USystem.Desktop",
    "SecretKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "Provider": "S3",
    "BucketName": "",
    "Region": "us-east-2",
    "ServiceUrl": "",
    "Prefix": "USystem",
    "PresignedUrlMinutes": 15,
    "MaxFileSizeMb": 10,
    "AllowedExtensions": "pdf,jpg,jpeg,png"
  },
  "Localization": {
    "DefaultLanguage": "es",
    "AvailableLanguages": [ "es", "en" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/usystem-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 15
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "USystem.Api"
    }
  },
  "AllowedHosts": "*"
}
