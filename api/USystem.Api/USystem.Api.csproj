<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>usystem-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Catálogos i18n: se copian al directorio de salida para publicar la API -->
    <Content Update="Resources\ErrorMessagesEs.json;Resources\ErrorMessagesEn.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\USystem.Application\USystem.Application.csproj" />
    <ProjectReference Include="..\USystem.Infrastructure\USystem.Infrastructure.csproj" />
  </ItemGroup>

</Project>
