{
  "name": "usystem-desktop",
  "productName": "U SYSTEM",
  "version": "0.1.2",
  "private": true,
  "description": "Cliente de escritorio de U SYSTEM (Electron + React + TypeScript)",
  "author": "U SYSTEM",
  "type": "module",
  "main": "dist-electron/Main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/WriteElectronManifest.cjs",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/GenerateIcons.mjs",
    "version:bump": "node scripts/BumpVersion.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build:electron && electron .",
    "dist:win": "npm run version:bump && npm run build && npm run build:electron && electron-builder --win",
    "dist:linux": "npm run version:bump && npm run build && npm run build:electron && electron-builder --linux",
    "dist:mac": "npm run version:bump && npm run build && npm run build:electron && electron-builder --mac"
  },
  "dependencies": {
    "@axzydev/axzy_ui_system": "^1.6.0",
    "i18next": "^25.0.0",
    "lottie-react": "^3.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
