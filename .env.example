# =============================================================================
# U SYSTEM API — variables de entorno para correr LOCAL
# =============================================================================
# 1. Copia este archivo:   cp .env.example .env
# 2. Llena los valores marcados [REQUERIDA].
# 3. Corre la API:          dotnet run --project api/USystem.Api
#
# - .env no se sube a git. Solo esta plantilla se versiona, sin secretos reales.
# - En PRODUCCIÓN (Railway) no se usa .env: las variables van en el panel de Railway.
#   Ver docs/Operations/Environments.md.
# - El doble guion bajo (__) equivale a una sección de appsettings.json:
#   Jwt__SecretKey  ==  { "Jwt": { "SecretKey": ... } }
# - Lo que no definas aquí toma el valor por defecto de api/USystem.Api/appsettings.json.
# =============================================================================


# --- Base de datos (MySQL 8.4 en Railway) -------------------------------------
# [REQUERIDA] Usa la conexión PÚBLICA del servicio MySQL en Railway
# (Variables -> MYSQL_PUBLIC_URL), convertida al formato .NET:
#   mysql://USUARIO:CLAVE@HOST:PUERTO/BASE  ->  Server=HOST;Port=PUERTO;Database=BASE;User=USUARIO;Password=CLAVE;...
# OJO: es la MISMA base que usa producción. Todo lo que hagas local cae en datos reales.
ConnectionStrings__DefaultConnection=Server=HOST.proxy.rlwy.net;Port=PUERTO;Database=railway;User=root;Password=CLAVE;SslMode=Preferred;AllowPublicKeyRetrieval=True;


# --- JWT (inicio de sesión) ---------------------------------------------------
# [REQUERIDA] Clave para firmar los tokens: mínimo 32 caracteres, distinta a la de producción.
# Genera una con:  openssl rand -base64 48
Jwt__SecretKey=


# --- Archivos (AWS S3) --------------------------------------------------------
# [REQUERIDA solo para subir/descargar documentos] Credenciales del usuario IAM del proyecto.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=cfsp-s3-bucket-prod
# [OPCIONAL] Solo si usas MinIO u otro proveedor compatible con S3.
# AWS_ENDPOINT_URL=http://localhost:9000


# --- Administrador inicial ----------------------------------------------------
# [OPCIONAL] Solo para el comando de una vez que crea el primer administrador:
#   dotnet run --project api/USystem.Api -- --seed-admin
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo. Bórrala después de usarla.
Seed__AdminPassword=
# Seed__AdminUsername=Administrator
# Seed__AdminEmail=admin@usystem.local
