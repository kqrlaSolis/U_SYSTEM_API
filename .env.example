# Plantilla de variables de entorno. Copiar a .env (ignorado por Git) y completar los secretos.
# Nunca se versionan credenciales reales.

# API
# MySQL 8: cadena en formato URI (la que entrega el proveedor) y en formato .NET (EF Core + Pomelo)
MYSQL_URL=mysql://usuario:clave@host:puerto/basededatos
ConnectionStrings__DefaultConnection=Server=host;Port=3306;Database=railway;User=usuario;Password=clave;SslMode=Preferred;AllowPublicKeyRetrieval=True;
Jwt__Issuer=USystem
Jwt__Audience=USystem.Desktop
Jwt__SecretKey=ChangeMeWithAtLeast32CharactersLong
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
# Solo desarrollo: contraseña del administrador inicial para
# `dotnet run --project api/USystem.Api -- --seed-admin`
Seed__AdminPassword=

# S3 (cadena de credenciales estándar de AWS)
AWS_REGION=us-east-2
AWS_BUCKET_NAME=cfsp-s3-bucket-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para MinIO u otro proveedor compatible
# AWS_ENDPOINT_URL=http://localhost:9000

# SMTP (proveedor pendiente de definir)
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=

# Desktop
VITE_API_BASE_URL=http://localhost:5000
